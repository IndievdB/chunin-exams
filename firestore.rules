rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each shinobi may read any profile but only write their own.
    match /shinobi/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (!("avatar" in request.resource.data) || request.resource.data.avatar is map)
        && (!("academy" in request.resource.data) || request.resource.data.academy is map)
        && (!("training" in request.resource.data) || request.resource.data.training is map)
        && (!("drafts" in request.resource.data) || request.resource.data.drafts is map)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && request.resource.data.clan is string && request.resource.data.clan.size() <= 24
        && (!("email" in request.resource.data) || request.resource.data.email == null || request.resource.data.email == request.auth.token.email);
      // The Hokage (admin) may grant or remove progress and pin a rank on any record, nothing else.
      allow update: if request.auth != null && request.auth.token.email == "indievdb@gmail.com"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["academy", "training", "rankOverride", "updatedAt"])
        && (!("academy" in request.resource.data) || request.resource.data.academy is map)
        && (!("training" in request.resource.data) || request.resource.data.training is map)
        && (!("rankOverride" in request.resource.data) || request.resource.data.rankOverride in ["Student", "Genin", "Chunin", "Jonin", "Kage"]);
      allow delete: if false;
      // Ask-sensei chat logs, one document per problem
      match /chats/{chat} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
